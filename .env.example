# Copy this file to .env and change both values before running the server.

# Password used to log in at /admin.
ADMIN_PASSWORD=change-me-before-deploy

# Long random string used to sign the admin session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Optional overrides.
# PORT=8080
# DATA_DIR=./data
